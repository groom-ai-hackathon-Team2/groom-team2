<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 백업/이전 정책. MVP 단계에서는 모든 데이터 백업 허용 기본값으로 충분.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
